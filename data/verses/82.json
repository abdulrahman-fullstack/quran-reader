{
  "chapterId": 82,
  "translation": {
    "source": "QuranEnc.com",
    "sourceUrl": "https://quranenc.com/en/home/api",
    "title": "English Translation - Noor International Center",
    "version": "1.1.2"
  },
  "verses": [
    {
      "number": 1,
      "arabicText": " إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
      "englishText": "When the sky breaks apart",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082001.mp3"
    },
    {
      "number": 2,
      "arabicText": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
      "englishText": "And when the stars fall, scattering,",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082002.mp3"
    },
    {
      "number": 3,
      "arabicText": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
      "englishText": "And when the seas are erupted",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082003.mp3"
    },
    {
      "number": 4,
      "arabicText": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
      "englishText": "And when the [contents of] graves are scattered [i.e., exposed],",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082004.mp3"
    },
    {
      "number": 5,
      "arabicText": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ",
      "englishText": "A soul will [then] know what it has put forth and kept back.",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082005.mp3"
    },
    {
      "number": 6,
      "arabicText": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
      "englishText": "O mankind, what has deceived you concerning your Lord, the Generous,",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082006.mp3"
    },
    {
      "number": 7,
      "arabicText": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
      "englishText": "Who created you, proportioned you, and balanced you?",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082007.mp3"
    },
    {
      "number": 8,
      "arabicText": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ",
      "englishText": "In whatever form He willed has He assembled you.",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082008.mp3"
    },
    {
      "number": 9,
      "arabicText": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
      "englishText": "No! But you deny the Recompense.",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082009.mp3"
    },
    {
      "number": 10,
      "arabicText": "وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ",
      "englishText": "And indeed, [appointed] over you are keepers,[1876]",
      "footnotes": "[1876] Angels who preserve the deeds of men in records.",
      "audioUrl": "Alafasy/mp3/082010.mp3"
    },
    {
      "number": 11,
      "arabicText": "كِرَامًا كَـٰتِبِينَ",
      "englishText": "Noble and recording;",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082011.mp3"
    },
    {
      "number": 12,
      "arabicText": "يَعْلَمُونَ مَا تَفْعَلُونَ",
      "englishText": "They know whatever you do.",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082012.mp3"
    },
    {
      "number": 13,
      "arabicText": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
      "englishText": "Indeed, the righteous will be in pleasure,",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082013.mp3"
    },
    {
      "number": 14,
      "arabicText": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ",
      "englishText": "And indeed, the wicked will be in Hellfire.",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082014.mp3"
    },
    {
      "number": 15,
      "arabicText": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ",
      "englishText": "They will [enter to] burn therein on the Day of Recompense,",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082015.mp3"
    },
    {
      "number": 16,
      "arabicText": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ",
      "englishText": "And never therefrom will they be absent.",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082016.mp3"
    },
    {
      "number": 17,
      "arabicText": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "englishText": "And what can make you know what is the Day of Recompense?",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082017.mp3"
    },
    {
      "number": 18,
      "arabicText": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "englishText": "Then, what can make you know what is the Day of Recompense?",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082018.mp3"
    },
    {
      "number": 19,
      "arabicText": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ",
      "englishText": "It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allāh.",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/082019.mp3"
    }
  ]
}
