{
  "chapterId": 96,
  "translation": {
    "source": "QuranEnc.com",
    "sourceUrl": "https://quranenc.com/en/home/api",
    "title": "English Translation - Noor International Center",
    "version": "1.1.2"
  },
  "verses": [
    {
      "number": 1,
      "arabicText": " ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "englishText": "Recite in the name of your Lord who created –",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096001.mp3"
    },
    {
      "number": 2,
      "arabicText": "خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ",
      "englishText": "Created man from a clinging substance.",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096002.mp3"
    },
    {
      "number": 3,
      "arabicText": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "englishText": "Recite, and your Lord is the most Generous -",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096003.mp3"
    },
    {
      "number": 4,
      "arabicText": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "englishText": "Who taught by the pen –",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096004.mp3"
    },
    {
      "number": 5,
      "arabicText": "عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ",
      "englishText": "Taught man that which he knew not.",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096005.mp3"
    },
    {
      "number": 6,
      "arabicText": "كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ",
      "englishText": "No! [But] indeed, man transgresses",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096006.mp3"
    },
    {
      "number": 7,
      "arabicText": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "englishText": "Because he sees himself self-sufficient.",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096007.mp3"
    },
    {
      "number": 8,
      "arabicText": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
      "englishText": "Indeed, to your Lord is the return.",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096008.mp3"
    },
    {
      "number": 9,
      "arabicText": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
      "englishText": "Have you seen the one who forbids",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096009.mp3"
    },
    {
      "number": 10,
      "arabicText": "عَبْدًا إِذَا صَلَّىٰٓ",
      "englishText": "A servant when he prays?",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096010.mp3"
    },
    {
      "number": 11,
      "arabicText": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
      "englishText": "Have you seen if he is upon guidance",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096011.mp3"
    },
    {
      "number": 12,
      "arabicText": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
      "englishText": "Or enjoins righteousness?",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096012.mp3"
    },
    {
      "number": 13,
      "arabicText": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "englishText": "Have you seen if he denies and turns away -",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096013.mp3"
    },
    {
      "number": 14,
      "arabicText": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "englishText": "Does he not know that Allāh sees?",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096014.mp3"
    },
    {
      "number": 15,
      "arabicText": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
      "englishText": "No! If he does not desist, We will surely drag him by the forelock[1952] –",
      "footnotes": "[1952] It may also mean \"slap him\" or \"blacken his face at the forelock.\"",
      "audioUrl": "Alafasy/mp3/096015.mp3"
    },
    {
      "number": 16,
      "arabicText": "نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ",
      "englishText": "A lying, sinning forelock.",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096016.mp3"
    },
    {
      "number": 17,
      "arabicText": "فَلْيَدْعُ نَادِيَهُۥ",
      "englishText": "Then let him call his associates;",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096017.mp3"
    },
    {
      "number": 18,
      "arabicText": "سَنَدْعُ ٱلزَّبَانِيَةَ",
      "englishText": "We will call the angels of Hell.[1953]",
      "footnotes": "[1953] Those who push the wicked into the Fire.",
      "audioUrl": "Alafasy/mp3/096018.mp3"
    },
    {
      "number": 19,
      "arabicText": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
      "englishText": "No! Do not obey him. But prostrate and draw near [to Allāh].",
      "footnotes": "",
      "audioUrl": "Alafasy/mp3/096019.mp3"
    }
  ]
}
